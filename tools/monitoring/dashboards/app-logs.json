{
  "id": null,
  "uid": "app-logs",
  "title": "App Logs (Loki)",
  "timezone": "browser",
  "tags": ["logs", "loki"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "logs",
      "title": "server-kotlin logs",
      "gridPos": { "h": 20, "w": 24, "x": 0, "y": 0 },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showLabels": true,
        "showTime": true
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "grafana-loki-datasource" },
          "expr": "{app=\"server-kotlin\"}",
          "refId": "A"
        }
      ]
    }
  ],
  "time": { "from": "now-30m", "to": "now" }
}


